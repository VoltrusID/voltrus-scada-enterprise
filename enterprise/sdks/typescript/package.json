  },
  "peerDependencies": {
    "voltrus": "0.47.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.3.0",
    "voltrus": "file:../../../core/sdks/typescript"
  }
}
