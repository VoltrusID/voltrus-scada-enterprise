{
  "name": "@voltrus/enterprise-sdk",
  "version": "0.47.1",
  "private": true,
  "description": "Official TypeScript SDK extension for the Voltrus SCADA Enterprise add-on endpoints",
  "license": "UNLICENSED",
  "main": "dist/index.js",
