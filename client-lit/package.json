    "dev": "tsc --watch & npx serve -l 5174 ."
  },
  "dependencies": {
    "dompurify": "3.4.1",
    "lit": "3.3.2",
    "marked": "18.0.2",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "esbuild": "^0.28.0",
    "typescript": "5.9.3"
  }
}
