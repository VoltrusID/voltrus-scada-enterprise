{
  "name": "voltrus-lite-client-lit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "build": "tsc && esbuild dist/main.js --bundle --format=esm --outfile=dist/bundle.js --minify",
