# Licence signing keys never live in this repository (see docs/official-build.md).
.license-private-key
license-signing-key*

# Local state and build output never belong in git.
*.db
*.db-shm
*.db-wal
voltrus-pre-restore-*.tar.gz
/target
target/
node_modules/
client/dist/
.playwright-mcp/
.env
.env.*
.dev.vars
*.p8

# Python bytecode and stray run state.
__pycache__/
*.py[cod]
scripts/sso-live/pid
# SDKs live in core/sdks and enterprise/sdks, not at the root.
/sdks/
